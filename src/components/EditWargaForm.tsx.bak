"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { updateProfile } from "@/actions/profile";

type Props = {
  initial: any;
};

export default function EditWargaForm({ initial }: Props) {
  const router = useRouter();
  const [form, setForm] = useState({
    email: initial.email || "",
    name: initial.name || "",
    nik: initial.nik || "",
    placeOfBirth: initial.placeOfBirth || "",
    dateOfBirth: initial.dateOfBirth
      ? new Date(initial.dateOfBirth).toISOString().slice(0, 10)
      : "",
    gender: initial.gender || "",
    address: initial.address || "",
    rtRw: initial.rtRw || "",
    kelurahan: initial.kelurahan || "",
    kecamatan: initial.kecamatan || "",
    city: initial.city || "",
    province: initial.province || "",
    postalCode: initial.postalCode || "",
    religion: initial.religion || "",
    maritalStatus: initial.maritalStatus || "",
    occupation: initial.occupation || "",
    nationality: initial.nationality || "WNI",
    phone: initial.phone || "",
    domicileBlock: initial.domicileBlock || "",
    ktpAddress: initial.ktpAddress || "",
    domicileNumber: initial.domicileNumber || "",
    hasKTPSukajaya: initial.hasKTPSukajaya || "belum",
    houseOwnership: initial.houseOwnership || "",
    profileVisibility: initial.profileVisibility || "public",
  });

  const [error, setError] = useState("");
  const [success, setSuccess] = useState(false);
  const [loading, setLoading] = useState(false);
  const [members, setMembers] = useState<any[]>(initial.familyMembers || []);

  function set(key: string, value: string) {
    setForm((prev) => ({ ...prev, [key]: value }));
  }

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError("");
    setSuccess(false);
    setLoading(true);

    try {
      const result = await updateProfile({ ...form, familyMembers: members });

      if (!result.ok) {
        setError(result.error);
        return;
      }

      setSuccess(true);
      setTimeout(() => router.back(), 1000);
    } catch {
      setError("Gagal menyimpan perubahan");
    } finally {
      setLoading(false);
    }
  }

  const fields = [
    ["name", "Nama Lengkap"],
    ["nik", "NIK"],
    ["placeOfBirth", "Tempat Lahir"],
    ["address", "Alamat"],
    ["domicileBlock", "Blok Domisili"],
    ["domicileNumber", "Nomor Rumah"],
    ["ktpAddress", "Alamat Sesuai KTP"],
    ["rtRw", "RT / RW"],
    ["kelurahan", "Kelurahan / Desa"],
    ["kecamatan", "Kecamatan"],
    ["city", "Kota / Kabupaten"],
    ["province", "Provinsi"],
    ["postalCode", "Kode Pos"],
    ["phone", "No. HP"],
    ["occupation", "Pekerjaan"],
  ];

  return (
    <form onSubmit={handleSubmit} className="card p-6 space-y-5">
      <h1 className="text-2xl font-bold text-slate-900">
        Edit Profil Saya
      </h1>

      {error && (
        <div className="rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700">
          {error}
        </div>
      )}

      {success && (
        <div className="rounded-lg bg-emerald-50 border border-emerald-200 p-3 text-sm text-emerald-700">
          Profil berhasil disimpan.
        </div>
      )}

      <div className="grid gap-4 sm:grid-cols-2">
        {fields.map(([key, label]) => (
          <div key={key}>
            <label className="label">{label}</label>
            <input
              className="input"
              value={(form as any)[key]}
              onChange={(e) => set(key, e.target.value)}
            />
          </div>
        ))}

        <div>
          <label className="label">Email</label>
          <input
            type="email"
            className="input"
            value={form.email}
            onChange={(e) => set("email", e.target.value)}
          />
        </div>

        <div>
          <label className="label">Tanggal Lahir</label>
          <input
            type="date"
            className="input"
            value={form.dateOfBirth}
            onChange={(e) => set("dateOfBirth", e.target.value)}
          />
        </div>

        <div>
          <label className="label">Jenis Kelamin</label>
          <select
            className="input"
            value={form.gender}
            onChange={(e) => set("gender", e.target.value)}
          >
            <option value="">Pilih</option>
            <option value="Laki-laki">Laki-laki</option>
            <option value="Perempuan">Perempuan</option>
          </select>
        </div>

        <div>
          <label className="label">Agama</label>
          <input
            className="input"
            value={form.religion}
            onChange={(e) => set("religion", e.target.value)}
          />
        </div>

        <div>
          <label className="label">Status Perkawinan</label>
          <input
            className="input"
            value={form.maritalStatus}
            onChange={(e) => set("maritalStatus", e.target.value)}
          />
        </div>

        <div>
          <label className="label">Kewarganegaraan</label>
          <input
            className="input"
            value={form.nationality}
            onChange={(e) => set("nationality", e.target.value)}
          />
        </div>

        <div>
          <label className="label">Kepemilikan Rumah</label>
          <select
            className="input"
            value={form.houseOwnership}
            onChange={(e) => set("houseOwnership", e.target.value)}
          >
            <option value="">Pilih</option>
            <option value="tetap">Tetap</option>
            <option value="sewa">Sewa</option>
          </select>
        </div>

        <div>
          <label className="label">KTP Sukajaya</label>
          <select
            className="input"
            value={form.hasKTPSukajaya}
            onChange={(e) => set("hasKTPSukajaya", e.target.value)}
          >
            <option value="ya">Ya</option>
            <option value="belum">Belum</option>
          </select>
        </div>

        <div>
          <label className="label">Privasi Profil</label>
          <select
            className="input"
            value={form.profileVisibility}
            onChange={(e) => set("profileVisibility", e.target.value)}
          >
            <option value="public">Publik</option>
            <option value="private">Pribadi</option>
          </select>
        </div>
      </div>

      <div className="mt-6">
        <h3 className="font-bold text-slate-900 text-sm">Anggota Kartu Keluarga</h3>

        <div className="mt-3 space-y-3">
          {members.map((m, idx) => (
            <div key={m.id || idx} className="grid gap-3 rounded-xl border border-slate-200 p-3 bg-slate-50">
              <div>
                <label className="label">Nama</label>
                <input
                  className="input"
                  value={m.name || ""}
                  onChange={(e) => {
                    const x = [...members];
                    x[idx] = { ...x[idx], name: e.target.value };
                    setMembers(x);
                  }}
                />
              </div>

              <div>
                <label className="label">Status</label>
                <input
                  className="input"
                  value={m.status || ""}
                  onChange={(e) => {
                    const x = [...members];
                    x[idx] = { ...x[idx], status: e.target.value };
                    setMembers(x);
                  }}
                />
              </div>

              <div>
                <label className="label">Agama</label>
                <input
                  className="input"
                  value={m.religion || ""}
                  onChange={(e) => {
                    const x = [...members];
                    x[idx] = { ...x[idx], religion: e.target.value };
                    setMembers(x);
                  }}
                />
              </div>

              <label className="flex items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  checked={!!m.isDeceased}
                  onChange={(e) => {
                    const x = [...members];
                    x[idx] = { ...x[idx], isDeceased: e.target.checked };
                    setMembers(x);
                  }}
                />
                Meninggal
              </label>

              <button
                type="button"
                className="btn btn-secondary text-red-600"
                onClick={() => setMembers(members.filter((_, i) => i !== idx))}
              >
                Hapus
              </button>
            </div>
          ))}

          <button
            type="button"
            className="btn btn-secondary"
            onClick={() =>
              setMembers([
                ...members,
                { name: "", status: "Anak", religion: "", isDeceased: false }
              ])
            }
          >
            + Tambah Anggota
          </button>
        </div>
      </div>

      <div className="flex gap-3 pt-4">
        <button
          type="button"
          className="btn btn-secondary"
          onClick={() => router.back()}
        >
          Batal
        </button>

        <button
          type="submit"
          disabled={loading}
          className="btn btn-primary"
        >
          {loading ? "Menyimpan..." : "Simpan Perubahan"}
        </button>
      </div>
    </form>
  );
}
